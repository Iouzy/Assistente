# Segredos e configuração local.
# O padrão apanha também as cópias (.env.bak, escrita pelo painel) — só o
# exemplo, que não tem segredos nenhuns, é que fica de fora.
.env*
!.env.example

# Base de dados
*.db
*.db-wal
*.db-shm

# Registos: contêm o texto das conversas e das notas.
*.log
*.log.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editores / SO
.vscode/
.idea/
.DS_Store
.stop-assistente

# Produtos da compilação (PyInstaller / Inno Setup).
/build/
/dist/
/version_info.txt
