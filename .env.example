# ---------------------------------------------------------------------------
# Configuração do Assistente Pessoal (copie este ficheiro para `.env`)
# ---------------------------------------------------------------------------

# OBRIGATÓRIO — token do bot, dado pelo @BotFather no Telegram.
TELEGRAM_TOKEN=123456789:AAExemploDeTokenDoBotFather

# OBRIGATÓRIO — chave da API DeepSeek (https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=sk-exemplo-da-sua-chave-deepseek

# ---------------------------------------------------------------------------
# Opcionais — os valores abaixo são os predefinidos.
# ---------------------------------------------------------------------------

# Endpoint e modelo DeepSeek (API compatível com OpenAI).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Caminho do ficheiro SQLite.
DATABASE_PATH=assistente.db

# Fuso horário IANA usado para interpretar datas naturais e agendar lembretes.
TIMEZONE=Europe/Lisbon

# Memória: mensagens mantidas em RAM antes de gerar um resumo,
# e quantas ficam depois de resumir.
MAX_HISTORY_MESSAGES=20
HISTORY_KEEP_MESSAGES=8

# Antecedência (minutos) do lembrete automático criado com cada evento.
EVENT_REMINDER_LEAD_MINUTES=15

# Lembretes que expiraram com o bot offline são enviados na mesma
# se o atraso for inferior a este número de minutos.
LATE_REMINDER_GRACE_MINUTES=120

# Rondas máximas de chamadas a ferramentas por mensagem (trava ciclos infinitos).
MAX_TOOL_ITERATIONS=5

# Tempos-limite de rede, em segundos. Suba-os se vir erros "Timed out" no
# arranque — acontece em ligações lentas ou com o tráfego do Telegram filtrado.
CONNECT_TIMEOUT=20
READ_TIMEOUT=30

# Nível de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
