# ---------------------------------------------------------------------------
# Configuração do Assistente Pessoal (copie este ficheiro para `.env`)
# ---------------------------------------------------------------------------

# OBRIGATÓRIO — token do bot, dado pelo @BotFather no Telegram.
TELEGRAM_TOKEN=123456789:AAExemploDeTokenDoBotFather

# OBRIGATÓRIO — chave da API DeepSeek (https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=sk-exemplo-da-sua-chave-deepseek

# RECOMENDADO — quem pode falar com o bot (ids numéricos do Telegram,
# separados por vírgulas). Um bot de Telegram é PÚBLICO: sem esta lista,
# qualquer pessoa que descubra o username pode conversar com ele e gastar o
# saldo da API DeepSeek.
#
# Para descobrir o seu id: arranque o bot sem esta linha, envie-lhe uma
# mensagem e procure nos registos «Mensagem de Nome (123456789)».
ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Opcionais — os valores abaixo são os predefinidos.
# ---------------------------------------------------------------------------

# Endpoint e modelo DeepSeek (API compatível com OpenAI).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Caminho do ficheiro SQLite.
DATABASE_PATH=assistente.db

# Fuso horário IANA usado para interpretar datas naturais e agendar lembretes.
TIMEZONE=Europe/Lisbon

# Memória de curto prazo: mensagens mantidas em RAM antes de gerar um resumo,
# e quantas ficam depois de resumir. Cada mensagem é reenviada em todas as
# chamadas à API — subir estes valores dá mais contexto imediato e custa mais.
MAX_HISTORY_MESSAGES=12
HISTORY_KEEP_MESSAGES=6

# Minutos de silêncio ao fim dos quais uma conversa é resumida e arrumada na
# base de dados, para não se perder se o processo morrer sem encerrar bem.
# 0 desliga (o resumo no encerramento continua a acontecer).
IDLE_FLUSH_MINUTES=30

# Antecedência (minutos) do lembrete automático criado com cada evento.
EVENT_REMINDER_LEAD_MINUTES=15

# Lembretes que expiraram com o bot offline são enviados na mesma
# se o atraso for inferior a este número de minutos.
LATE_REMINDER_GRACE_MINUTES=120

# Rondas máximas de chamadas a ferramentas por mensagem (trava ciclos infinitos).
MAX_TOOL_ITERATIONS=5

# Tempos-limite de rede, em segundos. Suba-os se vir erros "Timed out" no
# arranque — acontece em ligações lentas ou com o tráfego do Telegram filtrado.
CONNECT_TIMEOUT=20
READ_TIMEOUT=30

# Nível de logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Ficheiro de registo (roda automaticamente aos 5 MB, guarda 3 ficheiros).
# Deixe vazio para escrever apenas na consola. OBRIGATÓRIO se correr o bot
# sem janela (windows\iniciar_oculto.vbs), senão não há como ver os erros.
LOG_FILE=
